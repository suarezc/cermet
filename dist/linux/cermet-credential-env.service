# cermet-credential-env — cermetd's credential-transport preflight.
#
# cermetd's vault key arrives as a systemd encrypted credential, which systemd hands over by moving
# a mount onto /run/credentials/cermetd.service. That move is only visible to PID 1 when /run has
# SHARED propagation. Hosts always have it; container managers frequently do not, and the result was
# cermetd crash-looping on a filesystem error instead of refusing once, legibly.
#
# This unit converges exactly that one prerequisite, or refuses. Because it is Requires= of
# cermetd.service, a refusal here means cermetd is NEVER started: the environment is diagnosed by
# the unit whose job that is, and the operator reads one explanation instead of a restart loop.
#
# Two conditions, ANDed, and this unit runs only when BOTH hold — i.e. only when the prerequisite is
# actually load-bearing. A skipped condition counts as satisfied for Requires=, so cermetd starts
# normally in every other case.
#
#   ConditionVirtualization=container — on a real host or VM /run is shared already and there is
#       nothing to converge.
#   ConditionPathExists=/etc/credstore.encrypted/cermet.key — this box's custody rung is a SEALED
#       one, so a credential really is going to be delivered. A `file-protected` box has no blob and
#       needs no credential transport: making the propagation of /run its problem would keep a
#       perfectly healthy daemon down over a mechanism it does not use. That file's presence is the
#       single fact that drives both halves — systemd delivers the credential iff it exists, and
#       this preflight runs iff it exists.

[Unit]
Description=Cermet credential-transport preflight (/run mount propagation)
Documentation=https://github.com/cermet/cermet
Before=cermetd.service
ConditionVirtualization=container
ConditionPathExists=/etc/credstore.encrypted/cermet.key

[Service]
Type=oneshot
RemainAfterExit=yes

# DELIBERATELY UNHARDENED, and this is the one unit where that is the correct answer: its whole job
# is to change a mount in the HOST namespace of the container. PrivateTmp=, ProtectSystem=,
# PrivateMounts= — anything that gives this unit its own mount namespace — would make its mount
# invisible outside it, which is the exact failure mode it exists to repair. It runs as root, calls
# `mount` twice at most, touches one path, and exits.
ExecStart=/usr/local/libexec/cermet-credential-env

# No Restart=. A refusal here is a verdict about the environment, not a transient fault, and
# retrying it forever is the crash loop this unit was written to end.
